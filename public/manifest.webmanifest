{
  "name": "Brainly",
  "short_name": "Brainly",
  "description": "Save anything from any app. Brainly brings it back when it matters.",
  "id": "/",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F6F5F1",
  "theme_color": "#F6F5F1",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/save",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Today's run", "url": "/app", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
